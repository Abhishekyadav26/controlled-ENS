{
  "name": "controlled-ens",
  "version": "1.0.0",
  "description": "Priya's design studio: single front door router that discovers specialist agents from live ENS data on Sepolia.",
  "type": "module",
  "scripts": {
    "dev:agents": "tsx src/agents.ts",
    "dev:router": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start:agents": "node dist/agents.js",
    "start:router": "node dist/server.js",
    "ens:publish": "tsx src/ensPublish.ts",
    "evaluate": "tsx src/evaluate.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "viem": "^2.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.0",
    "@types/supertest": "^6.0.2",
    "supertest": "^6.3.4",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
